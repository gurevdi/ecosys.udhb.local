DATABASE_URL=postgresql://ecosys:change-me@127.0.0.1:5432/ecosys
JWT_SECRET=change-me
INIT_ADMIN_PASSWORD=EcosysAdmin47!
UPLOAD_DIR=/opt/ecosys/uploads
PORT=3000
# Режим отладки API: подробные логи и stack в ответах об ошибках
DEBUG=1
LDAP_URL=ldap://10.37.1.230
LDAP_URL_FAILOVER=ldap://10.37.1.231
LDAP_BIND_DN=ecosys@udhb.local
LDAP_BIND_PASSWORD=
LDAP_BASE=DC=udhb,DC=local
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
SMTP_FROM=ecosys@udhb.local
# Режим отладки фронтенда (при сборке Vite)
VITE_DEBUG=1
# LDAP service account (чтение каталога AD)
# LDAP_BIND_PASSWORD=secret
# Настройки AD (auto provision, sync) — в UI «Пользователи → Active Directory»
# URL СЭД (по умолчанию http://sed.omskgov.ru)
SED_BASE_URL=http://sed.omskgov.ru
